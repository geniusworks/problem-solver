# API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Session cookie for fetching problems and submitting solutions
PROBLEM_SITE_SESSION=your_session_cookie_here

# LLM Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=codellama-13b-instruct  # Primary model for solution generation

# Solution Settings
SUBMIT_SOLUTIONS=false  # Set to true to submit solutions to AoC website
EMBARGO_HOURS=2        # Number of hours to wait after puzzle release before allowing solution

# Hardware Configuration
HARDWARE_PROFILE=m1_16gb     # Options: m1_16gb, m2_32gb, custom
MAX_MODEL_SIZE=13           # Maximum model size in billions of parameters
CONCURRENT_MODELS=1         # Number of models to run simultaneously
PREFER_SMALLER_MODELS=true  # Use smaller models when sufficient

# Model Preferences
PRIMARY_MODEL_PREFERENCE=local     # Model for solution generation
REVIEW_MODEL_PREFERENCE=local      # Model for code review
VALIDATOR_MODEL_PREFERENCE=local   # Model for solution validation

# Model Configurations
DEFAULT_TEMPERATURE=0.1      # Lower temperature for more focused outputs
MAX_TOKENS=2000             # Maximum tokens per response
TIMEOUT_SECONDS=60          # Maximum time to wait for model response

# Performance Tuning
GPU_MEMORY_UTILIZATION=70  # Percentage of GPU memory to use (0-100)
CPU_THREAD_COUNT=8         # Number of CPU threads to use
METAL_ENABLED=true        # Use Metal for Apple Silicon acceleration
