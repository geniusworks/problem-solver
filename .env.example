# API Keys (Required for cloud models)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Session cookie for fetching problems and submitting solutions
AOC_SESSION=your_session_cookie_here

# LLM Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=codellama-7b-instruct

# Hardware Configuration
HARDWARE_PROFILE=m1_16gb  # See config/hardware.yaml for available profiles
MAX_MODEL_SIZE=13         # Override profile setting if needed
CONCURRENT_MODELS=1       # Override profile setting if needed

# Model Preferences
PRIMARY_MODEL_PREFERENCE=local
REVIEW_MODEL_PREFERENCE=local
VALIDATOR_MODEL_PREFERENCE=local

# Performance Settings
GPU_MEMORY_UTILIZATION=70  # Override profile setting if needed
CPU_THREAD_COUNT=8         # Override profile setting if needed
METAL_ENABLED=true         # Override profile setting if needed

# Debug Settings
LOG_LEVEL=INFO

# Contact string included in the User-Agent header, per Advent of Code automation
# guidelines. Optional; omit to send a generic identifying agent.
AOC_CONTACT=

# Remote (paid) LLM providers are disabled by default. A present API key is NOT
# sufficient to enable them -- set this explicitly to opt in to per-token billing.
ENABLE_REMOTE_PROVIDERS=false
