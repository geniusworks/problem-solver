# API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AOC_SESSION=  # Your Advent of Code session cookie

# Model Endpoints
OLLAMA_BASE_URL=http://localhost:11434  # Base URL for Ollama API

# Hardware Configuration
HARDWARE_PROFILE=m1_16gb  # Options: m1_16gb, m2_32gb, custom
MAX_MODEL_SIZE=13  # Maximum model size in billions of parameters
CONCURRENT_MODELS=2  # How many models to run concurrently
PREFER_SMALLER_MODELS=true  # Prefer smaller, faster models when possible

# Model Preferences
PRIMARY_MODEL_PREFERENCE=local  # local, cloud, or auto
REVIEW_MODEL_PREFERENCE=cloud   # local, cloud, or auto
VALIDATOR_MODEL_PREFERENCE=local # local, cloud, or auto

# Performance Tuning
GPU_MEMORY_UTILIZATION=70  # Percentage of GPU memory to use (0-100)
CPU_THREAD_COUNT=8         # Number of CPU threads to use
METAL_ENABLED=true        # Use Metal for Apple Silicon acceleration
