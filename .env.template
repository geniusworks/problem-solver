# Advent of Code session cookie
# Get this from your browser's cookies after logging in to adventofcode.com
# It should be a long hexadecimal string
AOC_SESSION=your_session_cookie_here

# LLM Configuration
LLM_PROVIDER=anthropic  # or other supported providers
LLM_API_KEY=your_api_key_here
LLM_MODEL=claude-2  # or other model identifier

# Optional Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
RATE_LIMIT_DELAY=1  # Delay between API requests in seconds
